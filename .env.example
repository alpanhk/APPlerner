# Contoh environment untuk Lernen (Next.js + PostgreSQL).
# Salin ke .env.local dan isi dengan kredensial lokal Anda.
# JANGAN memasukkan rahasia ke Git. File .env* sudah diabaikan (.gitignore),
# kecuali file contoh ini.
#
# Untuk preview terisolasi tanpa Postgres sistem, jalankan:
#   npm run preview:db
# Skrip itu menyalakan Postgres tertanam (embedded-postgres) di port 5433
# dan mencetak DATABASE_URL yang siap dipakai.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
