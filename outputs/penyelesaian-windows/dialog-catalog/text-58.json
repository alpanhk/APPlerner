  "sourceMap": [
    {
      "index": 0,
      "de": "Künstliche Intelligenz bietet viele Chancen, wirft aber auch Fragen auf.",
      "id": "Kecerdasan buatan menawarkan banyak peluang, tetapi juga memunculkan pertanyaan.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Einerseits kann sie Menschen helfen, andererseits kann sie überwachen.",
      "id": "Di satu sisi ia membantu, di sisi lain bisa mengawasi.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Entscheidungen müssen ethisch begründet werden.",
      "id": "Keputusan harus dibenarkan secara etis.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Man hätte früher über Datenschutz diskutieren müssen.",
      "id": "Kita seharusnya lebih awal mendiskusikan perlindungan data.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Die Würde des Menschen darf nicht verletzt werden.",
      "id": "Martabat manusia tidak boleh dilanggar.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Nur verantwortungsvolle Regeln schaffen Vertrauen.",
      "id": "Hanya aturan yang bertanggung jawab menciptakan kepercayaan.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
  ],
