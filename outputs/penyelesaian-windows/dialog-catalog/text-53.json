  "sourceMap": [
    {
      "index": 0,
      "de": "Die Klimapolitik steht vor großen Aufgaben.",
      "id": "Kebijakan iklim menghadapi tugas besar.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Die Emissionen müssen deutlich gesenkt werden.",
      "id": "Emisinya harus diturunkan secara signifikan.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Energiewende wird langfristig Arbeitsplätze schaffen.",
      "id": "Transisi energi akan menciptakan lapangan kerja jangka panjang.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Allerdings sind nicht alle Ziele verbindlich.",
      "id": "Namun tidak semua target bersifat mengikat.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Falls die Vereinbarungen nicht eingehalten werden, drohen neue Konflikte.",
      "id": "Jika kesepakatan tidak dipatuhi, ancaman konflik baru muncul.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Der Verbrauch von Ressourcen muss sinken, damit die Ziele erreicht werden.",
      "id": "Konsumsi sumber daya harus turun agar target tercapai.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
