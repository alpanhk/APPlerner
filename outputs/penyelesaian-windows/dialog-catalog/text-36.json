  "sourceMap": [
    {
      "index": 0,
      "de": "Gestern war mein Handy kaputt.",
      "id": "Kemarin ponsel saya rusak.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Ich konnte keine Nachrichten lesen und keine E-Mails senden.",
      "id": "Saya tidak bisa membaca pesan dan tidak bisa mengirim surel.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Mein Passwort hatte ich auch vergessen.",
      "id": "Kata sandi saya juga lupa.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Ich weiß nicht, ob ich die App neu installieren muss.",
      "id": "Saya tidak tahu apakah saya harus memasang ulang aplikasinya.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am Abend habe ich endlich den Computer benutzt.",
      "id": "Malamnya akhirnya saya memakai komputer.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Ich glaube, dass ich mich zu sehr auf das Handy verlasse.",
      "id": "Saya rasa saya terlalu bergantung pada ponsel.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
  ],
