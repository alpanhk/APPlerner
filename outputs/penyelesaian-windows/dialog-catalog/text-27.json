  "sourceMap": [
    {
      "index": 0,
      "de": "Im Winter funktioniert die Heizung im Schlafzimmer nicht.",
      "id": "Pada musim dingin pemanas di kamar tidur tidak berfungsi.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Frau Berger ruft den Hausmeister an.",
      "id": "Ibu Berger menelepon pengelola gedung.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Er kommt am Nachmittag vorbei und prüft den Heizkörper.",
      "id": "Dia datang pada sore hari dan memeriksa radiator.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Ein kleines Ersatzteil fehlt, deshalb muss er noch einmal kommen.",
      "id": "Satu suku cadang kecil tidak ada, karena itu dia harus datang lagi.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am Abend ist das Zimmer wieder warm.",
      "id": "Pada malam hari kamar itu kembali hangat.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    }
