  "sourceMap": [
    {
      "index": 0,
      "de": "Letztes Jahr habe ich meinen Geburtstag im Garten gefeiert.",
      "id": "Tahun lalu saya merayakan ulang tahun di taman.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Ich habe viele Freunde und meine Familie eingeladen.",
      "id": "Saya mengundang banyak teman dan keluarga.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Meine Schwester hat mir ein Buch geschenkt.",
      "id": "Kakak perempuan saya memberi saya sebuah buku.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Wir haben gegrillt und bis Mitternacht gefeiert.",
      "id": "Kami memanggang dan berpesta sampai tengah malam.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Als ich die Gäste gesehen habe, war ich sehr glücklich.",
      "id": "Saat melihat para tamu, saya sangat bahagia.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Nächstes Jahr möchte ich wieder feiern.",
      "id": "Tahun depan saya ingin merayakannya lagi.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
