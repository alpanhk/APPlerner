  "sourceMap": [
    {
      "index": 0,
      "de": "Am Wochenende bin ich nach Hamburg gefahren.",
      "id": "Pada akhir pekan saya pergi ke Hamburg.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Die Fahrt hat drei Stunden gedauert.",
      "id": "Perjalanannya memakan waktu tiga jam.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Ich habe meine Tante besucht.",
      "id": "Saya mengunjungi bibi saya.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Wir haben einen Spaziergang an der Elbe gemacht.",
      "id": "Kami berjalan-jalan di tepi sungai Elbe.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Das Wetter war leider kalt und windig.",
      "id": "Cuacanya sayangnya dingin dan berangin.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Am Abend sind wir in einem kleinen Restaurant gegessen.",
      "id": "Pada malam hari kami makan di sebuah restoran kecil.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
