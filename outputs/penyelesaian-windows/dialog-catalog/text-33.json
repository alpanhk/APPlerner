      "index": 0,
      "de": "Letzten Sommer sind wir an die Ostsee gefahren.",
      "id": "Musim panas lalu kami pergi ke Laut Baltik.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Die Reise hat sechs Stunden gedauert.",
      "id": "Perjalanannya memakan waktu enam jam.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Wir haben ein kleines Hotel am Strand gebucht.",
      "id": "Kami memesan hotel kecil di pantai.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Am Morgen sind wir im Meer geschwommen.",
      "id": "Pagi hari kami berenang di laut.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am Nachmittag haben wir die Stadt besucht.",
      "id": "Sore hari kami mengunjungi kota.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Nächstes Jahr wollen wir nach Wien fahren.",
      "id": "Tahun depan kami ingin pergi ke Wina.",
