  "sourceMap": [
    {
      "index": 0,
      "de": "Im Sommer verbringen wir eine Woche an der Ostsee.",
      "id": "Pada musim panas kami menghabiskan seminggu di Laut Baltik.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Morgens gehen wir am Strand spazieren.",
      "id": "Pagi hari kami berjalan-jalan di pantai.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Wenn die Sonne scheint, schwimmen die Kinder im Meer.",
      "id": "Jika matahari bersinar, anak-anak berenang di laut.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Bei schlechtem Wetter besuchen wir ein kleines Museum.",
      "id": "Saat cuaca buruk kami mengunjungi museum kecil.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Die Reise war erholsam, obwohl die Anfahrt lang war.",
      "id": "Liburannya menyenangkan, meskipun perjalanan ke sana lama.",
      "mappedTo": [
        "t05"
