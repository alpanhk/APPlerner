  "sourceMap": [
    {
      "index": 0,
      "de": "Der Klimawandel ist eines der wichtigsten Themen unserer Zeit.",
      "id": "Perubahan iklim adalah salah satu topik terpenting zaman ini.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Wegen des Klimawandels ändern sich Wetter und Jahreszeiten.",
      "id": "Karena perubahan iklim cuaca dan musim berubah.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Vieles kann getan werden, um Energie zu sparen.",
      "id": "Banyak hal bisa dilakukan untuk menghemat energi.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Plastikverpackungen sollten vermieden werden.",
      "id": "Kemasan plastik sebaiknya dihindari.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Es gibt aber auch Kritik an manchen Maßnahmen.",
      "id": "Namun ada juga kritik terhadap sebagian tindakan.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Trotzdem bleibt es wichtig, jetzt zu handeln.",
      "id": "Meskipun begitu tetap penting untuk bertindak sekarang.",
      "mappedTo": [
        "t06"
      ],
