  "sourceMap": [
    {
      "index": 0,
      "de": "Sari sucht seit zwei Monaten eine neue Stelle.",
      "id": "Sari sudah dua bulan mencari posisi baru.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Sie hat ihre Bewerbung an eine Firma in Hamburg geschickt.",
      "id": "Dia mengirim lamarannya ke sebuah perusahaan di Hamburg.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Ihr Lebenslauf ist übersichtlich und ihre Erfahrung ist groß.",
      "id": "CV-nya rapi dan pengalamannya banyak.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Am Montag hat sie ein Vorstellungsgespräch.",
      "id": "Hari Senin dia ada wawancara kerja.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Der Chef fragt, warum sie wechseln will.",
      "id": "Atasan bertanya mengapa dia ingin pindah.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Sie sagt, weil sie mehr Verantwortung möchte.",
      "id": "Dia menjawab, karena ingin lebih banyak tanggung jawab.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
