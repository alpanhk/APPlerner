  "sourceMap": [
    {
      "index": 0,
      "de": "Vor zwei Wochen ist ein neuer Nachbar eingezogen.",
      "id": "Dua pekan lalu seorang tetangga baru pindah masuk.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Der Mietvertrag wurde gestern unterschrieben.",
      "id": "Kontrak sewanya ditandatangani kemarin.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Klingel, die kaputt war, wurde sofort repariert.",
      "id": "Bel yang rusak itu langsung diperbaiki.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Manchmal beschwert sich jemand über den Lärm.",
      "id": "Kadang seseorang mengeluh soal kebisingan.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Trotzdem ist die Nachbarschaft sehr freundlich.",
      "id": "Meskipun begitu, lingkungan tetangganya sangat ramah.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Bei Problemen hilft der Hausmeister immer.",
      "id": "Kalau ada masalah, petugas gedung selalu membantu.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
