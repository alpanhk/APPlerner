      "index": 0,
      "de": "Rudi hat seit gestern Kopfschmerzen.",
      "id": "Rudi sakit kepala sejak kemarin.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Er ruft die Arztpraxis an.",
      "id": "Dia menelepon tempat praktik dokter.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Ärztin fragt: Was fehlt Ihnen?",
      "id": "Dokter perempuan bertanya: Apa keluhan Anda?",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Rudi soll viel Wasser trinken und sich ausruhen.",
      "id": "Rudi sebaiknya banyak minum air dan beristirahat.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am nächsten Tag geht es ihm besser.",
      "id": "Keesokan harinya keadaannya membaik.",
      "mappedTo": [
