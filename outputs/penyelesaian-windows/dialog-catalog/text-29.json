  "sourceMap": [
    {
      "index": 0,
      "de": "Wir haben endlich eine neue Wohnung gefunden.",
      "id": "Akhirnya kami menemukan apartemen baru.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Sie ist hell und liegt im dritten Stock.",
      "id": "Apartemennya terang dan berada di lantai tiga.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Miete ist nicht billig, aber die Lage ist gut.",
      "id": "Sewanya tidak murah, tetapi lokasinya bagus.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Der Vermieter hat uns die Nebenkosten erklärt.",
      "id": "Pemilik sewa menjelaskan biaya tambahan kepada kami.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am Wochenende renovieren wir das Bad.",
      "id": "Akhir pekan ini kami merenovasi kamar mandi.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Im Mai ziehen wir um.",
      "id": "Bulan Mei kami pindah.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
