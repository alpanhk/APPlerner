    {
      "index": 0,
      "de": "Sari lädt ihre Nachbarn zum Abendessen ein.",
      "id": "Sari mengundang tetangganya untuk makan malam.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Sie schreibt die Einladung in eine Nachricht.",
      "id": "Dia menulis undangannya dalam sebuah pesan.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Ihre Nachbarn fragen, ob sie etwas mitbringen sollen.",
      "id": "Tetangganya bertanya apakah mereka perlu membawa sesuatu.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Sari bittet sie, einen Salat mitzubringen.",
      "id": "Sari meminta mereka membawa salad.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Um halb sieben klingeln die Gäste an der Tür.",
      "id": "Pukul setengah tujuh para tamu membunyikan bel pintu.",
