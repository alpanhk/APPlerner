  "sourceMap": [
    {
      "index": 0,
      "de": "Das Unternehmen steckt seit zwei Jahren in einer Krise.",
      "id": "Perusahaan itu dua tahun dalam krisis.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Der Umsatz ist gesunken, während die Kosten gestiegen sind.",
      "id": "Omzet menurun sementara biaya naik.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Einerseits braucht die Firma Investitionen, andererseits fehlt das Geld.",
      "id": "Di satu sisi perusahaan butuh investasi, di sisi lain uangnya kurang.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Die Geschäftsführung hat eine neue Strategie beschlossen.",
      "id": "Manajemen memutuskan strategi baru.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Ein Teil der Produktion ist bereits verlagert.",
      "id": "Sebagian produksi sudah dipindahkan.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Ob die Strategie rentabel ist, wird sich nächstes Jahr zeigen.",
      "id": "Apakah strateginya menguntungkan akan terlihat tahun depan.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
