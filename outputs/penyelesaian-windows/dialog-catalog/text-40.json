  "sourceMap": [
    {
      "index": 0,
      "de": "Seit einem Jahr lebe ich gesünder.",
      "id": "Sejak setahun lalu saya hidup lebih sehat.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Ich achte auf meine Ernährung und koche selbst.",
      "id": "Saya memperhatikan pola makan dan memasak sendiri.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Außerdem versuche ich, jeden Tag zu laufen.",
      "id": "Selain itu saya berusaha berlari setiap hari.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Wenn ich gestresst wäre, würde ich mehr Sport machen.",
      "id": "Kalau saya stres, saya akan lebih banyak olahraga.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Auf Zucker verzichte ich fast ganz.",
      "id": "Gula hampir sepenuhnya saya hindari.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Guter Schlaf ist für mich genauso wichtig wie Bewegung.",
      "id": "Tidur yang baik sama pentingnya bagi saya dengan olahraga.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
