  "sourceMap": [
    {
      "index": 0,
      "de": "Eine neue Studie wurde letzte Woche veröffentlicht.",
      "id": "Sebuah studi baru diterbitkan pekan lalu.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Die untersuchten Fälle zeigen einen klaren Zusammenhang.",
      "id": "Kasus yang diteliti menunjukkan kaitan yang jelas.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Allerdings ist der Zusammenhang noch nicht bewiesen.",
      "id": "Namun kaitannya belum terbukti.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Die Forscher betonen, dass weitere Experimente nötig seien.",
      "id": "Para peneliti menekankan bahwa eksperimen lanjutan masih perlu.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Infolgedessen fordern sie mehr Förderung für die Wissenschaft.",
      "id": "Sebagai akibatnya mereka menuntut lebih banyak dana untuk ilmu pengetahuan.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Die Ergebnisse müssen unabhängig geprüft werden.",
      "id": "Hasilnya harus diperiksa secara independen.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
