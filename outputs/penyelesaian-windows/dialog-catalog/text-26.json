  "sourceMap": [
    {
      "index": 0,
      "de": "Auf dem Wochenmarkt kauft Lani frisches Gemüse.",
      "id": "Di pasar mingguan Lani membeli sayuran segar.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Der Verkäufer wiegt ein Kilo Tomaten ab.",
      "id": "Penjual menimbang satu kilogram tomat.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Lani fragt, ob die Äpfel aus der Region kommen.",
      "id": "Lani bertanya apakah apel-apel itu berasal dari daerah setempat.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Sie bezahlt bar und bekommt das Wechselgeld zurück.",
      "id": "Dia membayar tunai dan menerima kembaliannya.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Zu Hause kocht sie aus dem Gemüse eine Suppe.",
      "id": "Di rumah dia memasak sup dari sayuran itu.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    }
