  "sourceMap": [
    {
      "index": 0,
      "de": "Ich bin in Indonesien geboren und lebe jetzt in Deutschland.",
      "id": "Saya lahir di Indonesia dan kini tinggal di Jerman.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Meine Herkunft prägt mich, aber sie bestimmt mich nicht allein.",
      "id": "Asal-usul saya membentuk saya, tetapi tidak menentukan segalanya.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Identität entsteht, indem man Erfahrungen sammelt.",
      "id": "Identitas terbentuk dengan mengumpulkan pengalaman.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Die Vielfalt der Kulturen empfinde ich als Bereicherung.",
      "id": "Keberagaman budaya saya rasakan sebagai kekayaan.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Manchmal ist das Fremde zunächst irritierend.",
      "id": "Kadang yang asing awalnya mengganggu.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Wer respektvoll miteinander umgeht, lernt am meisten.",
      "id": "Siapa yang saling menghormati belajar paling banyak.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
  ],
