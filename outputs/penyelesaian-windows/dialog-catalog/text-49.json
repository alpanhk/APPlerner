  "sourceMap": [
    {
      "index": 0,
      "de": "Die Arbeitswelt befindet sich in einem tiefen Wandel.",
      "id": "Dunia kerja berada dalam perubahan mendalam.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Digitalisierung und Automatisierung verändern viele Berufe.",
      "id": "Digitalisasi dan otomatisasi mengubah banyak profesi.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Gleichzeitig entstehen neue Berufe, die spezielle Qualifikationen verlangen.",
      "id": "Pada saat yang sama muncul profesi baru yang menuntut kualifikasi khusus.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Weiterbildung wird deshalb immer wichtiger.",
      "id": "Karena itu pendidikan lanjutan makin penting.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Die Gewerkschaften fordern bessere Bedingungen für die Beschäftigten.",
      "id": "Serikat pekerja menuntut kondisi lebih baik bagi pekerja.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Nur wer flexibel bleibt, kann auf dem Arbeitsmarkt bestehen.",
      "id": "Hanya yang tetap fleksibel dapat bertahan di pasar kerja.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
