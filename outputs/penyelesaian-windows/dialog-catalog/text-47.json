  "sourceMap": [
    {
      "index": 0,
      "de": "Seit Januar habe ich ein festes Budget.",
      "id": "Sejak Januari saya punya anggaran tetap.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Ich schreibe jede Ausgabe auf.",
      "id": "Saya mencatat setiap pengeluaran.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Wenn ich weniger ausgeben würde, könnte ich mehr sparen.",
      "id": "Jika saya mengurangi pengeluaran, saya bisa lebih banyak menabung.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Die Versicherung ist teuer, aber notwendig.",
      "id": "Asuransinya mahal, tetapi perlu.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Wegen der hohen Kosten koche ich öfter zu Hause.",
      "id": "Karena biaya tinggi saya lebih sering memasak di rumah.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Ich weiß noch nicht, ob ich dieses Jahr verreisen kann.",
      "id": "Saya belum tahu apakah bisa bepergian tahun ini.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
