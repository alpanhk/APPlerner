  "sourceMap": [
    {
      "index": 0,
      "de": "Am Samstag muss Dimas nicht arbeiten.",
      "id": "Pada hari Sabtu Dimas tidak harus bekerja.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Er schläft lange und frühstückt auf dem Balkon.",
      "id": "Dia tidur sampai siang dan sarapan di balkon.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Danach trifft er seine Freunde im Stadtzentrum.",
      "id": "Setelah itu dia bertemu teman-temannya di pusat kota.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Sie besuchen eine Ausstellung, weil sie sich für Fotografie interessieren.",
      "id": "Mereka mengunjungi pameran karena tertarik pada fotografi.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am Abend kochen sie gemeinsam und hören Musik.",
      "id": "Malam harinya mereka memasak bersama dan mendengarkan musik.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    }
