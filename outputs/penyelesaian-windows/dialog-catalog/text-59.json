    {
      "index": 0,
      "de": "Am Samstag ziehen wir in die neue Wohnung.",
      "id": "Hari Sabtu kami pindah ke apartemen baru.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Die Möbel sind schon im Lastwagen.",
      "id": "Mebelnnya sudah di dalam truk.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Mein Bruder hilft uns beim Tragen.",
      "id": "Saudara laki-laki saya membantu mengangkat.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Die Nachbarn haben uns begrüßt.",
      "id": "Tetangga-tetangganya menyapa kami.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am Abend sind wir sehr müde.",
      "id": "Malamnya kami sangat lelah.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
