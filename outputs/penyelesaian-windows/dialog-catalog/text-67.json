  "sourceMap": [
    {
      "index": 0,
      "de": "Eine neue Studie untersuchte den Zusammenhang von Schlaf und Stress.",
      "id": "Sebuah studi baru meneliti kaitan tidur dan stres.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Die Ergebnisse deuten darauf hin, dass Schlafmangel das Risiko erhöht.",
      "id": "Hasilnya menunjukkan kurang tidur meningkatkan risiko.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Allerdings ist die Stichprobe relativ klein.",
      "id": "Namun sampelnya relatif kecil.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Die Forscher warnen deshalb vor voreiligen Schlüssen.",
      "id": "Karena itu para peneliti memperingatkan kesimpulan terburu-buru.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Weitere Untersuchungen sollen die Befunde überprüfen.",
      "id": "Penelitian lanjutan akan memverifikasi temuan itu.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Trotzdem wird empfohlen, regelmäßig zu schlafen.",
      "id": "Meskipun begitu disarankan tidur secara teratur.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
