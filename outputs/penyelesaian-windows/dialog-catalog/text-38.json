  "sourceMap": [
    {
      "index": 0,
      "de": "In Deutschland wird der Müll zu Hause getrennt.",
      "id": "Di Jerman sampah dipilah di rumah.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Papier, Glas und Plastik kommen in verschiedene Tonnen.",
      "id": "Kertas, kaca, dan plastik masuk ke tong berbeda.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Man spart Energie, wenn man Flaschen recycelt.",
      "id": "Orang menghemat energi jika mendaur ulang botol.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Ich kaufe keine Tüten mehr und benutze eine Tasche.",
      "id": "Saya tidak membeli kantong lagi dan memakai tas.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Umweltschutz ist wichtig, deshalb fahre ich oft Fahrrad.",
      "id": "Perlindungan lingkungan penting, karena itu saya sering bersepeda.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Kleine Dinge ändern viel.",
      "id": "Hal-hal kecil mengubah banyak hal.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
  ],
