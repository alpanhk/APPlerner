  "sourceMap": [
    {
      "index": 0,
      "de": "Ich fahre jeden Tag mit dem Bus zur Arbeit.",
      "id": "Setiap hari saya naik bus ke tempat kerja.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Die Haltestelle ist nur fünf Minuten von meiner Wohnung.",
      "id": "Haltenya hanya lima menit dari apartemen saya.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Ich steige am Hauptbahnhof um.",
      "id": "Saya ganti kendaraan di stasiun utama.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Die Straßenbahn fährt dann direkt ins Zentrum.",
      "id": "Tremnya langsung menuju pusat kota.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Manchmal ist der Verkehr sehr stark.",
      "id": "Kadang lalu lintasnya sangat padat.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Dann brauche ich eine Stunde statt dreißig Minuten.",
      "id": "Kalau begitu saya butuh sejam, bukan tiga puluh menit.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
