  "sourceMap": [
    {
      "index": 0,
      "de": "Seit einer Woche gibt es Streit im Haus.",
      "id": "Sejak sepekan ada pertengkaran di gedung.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Ein Mieter hört abends laute Musik.",
      "id": "Seorang penyewa mendengar musik keras pada malam hari.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Nachbarn fühlen sich gestört und beschweren sich.",
      "id": "Para tetangga merasa terganggu dan mengeluh.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Der Hausmeister schlägt ein Gespräch vor.",
      "id": "Petugas gedung mengusulkan pertemuan.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Bei dem Gespräch einigen sich alle auf ruhigere Zeiten.",
      "id": "Dalam pertemuan itu semua sepakat waktu yang lebih tenang.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Danach ist die Stimmung im Haus besser.",
      "id": "Setelah itu suasana di gedung lebih baik.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
