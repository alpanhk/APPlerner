  "sourceMap": [
    {
      "index": 0,
      "de": "Für den Antrag braucht man einen Termin.",
      "id": "Untuk permohonan itu butuh janji temu.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Der Antrag muss persönlich abgegeben werden.",
      "id": "Permohonannya harus diserahkan langsung.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Falls Unterlagen fehlen, wird der Antrag abgelehnt.",
      "id": "Jika dokumen kurang, permohonan ditolak.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Die Genehmigung wird nach der Prüfung erteilt.",
      "id": "Izin diterbitkan setelah pemeriksaan.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Gegen den Bescheid kann man klagen.",
      "id": "Terhadap keputusan itu orang bisa menggugat.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Zuständig ist das Amt am Hauptbahnhof.",
      "id": "Yang berwenang adalah kantor di stasiun utama.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
