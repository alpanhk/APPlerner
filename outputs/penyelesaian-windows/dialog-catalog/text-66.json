  "sourceMap": [
    {
      "index": 0,
      "de": "Künstliche Intelligenz verändert zunehmend die Arbeitswelt.",
      "id": "Kecerdasan buatan makin mengubah dunia kerja.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Viele Aufgaben können automatisiert werden.",
      "id": "Banyak tugas dapat diotomatiskan.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Dadurch entstehen neue Berufe, während andere verschwinden.",
      "id": "Akibatnya muncul profesi baru sementara yang lain hilang.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Fachleute betonen, dass Weiterbildung entscheidend ist.",
      "id": "Para ahli menekankan bahwa pendidikan lanjutan menentukan.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Zugleich wird über Datenschutz und Verantwortung diskutiert.",
      "id": "Pada saat yang sama dibahas perlindungan data dan tanggung jawab.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Nur durch klare Regeln lässt sich Vertrauen schaffen.",
      "id": "Hanya lewat aturan yang jelas kepercayaan dapat dibangun.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
