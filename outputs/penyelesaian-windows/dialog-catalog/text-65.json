  "sourceMap": [
    {
      "index": 0,
      "de": "Im Parlament wurde gestern über das neue Gesetz debattiert.",
      "id": "Kemarin parlemen mendebatkan undang-undang baru.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Die Regierung argumentiert, die Reform sei notwendig.",
      "id": "Pemerintah berargumen reformasi itu perlu.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Opposition bezweifelt, dass die Kosten tragbar sind.",
      "id": "Oposisi meragukan bahwa biayanya dapat ditanggung.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Ein Abgeordneter wies darauf hin, dass die Frist zu kurz sei.",
      "id": "Seorang anggota parlemen menunjukkan tenggatnya terlalu singkat.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am Ende wurde der Entwurf mit knapper Mehrheit angenommen.",
      "id": "Akhirnya rancangan itu diterima dengan mayoritas tipis.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Nun muss die Umsetzung sorgfältig überprüft werden.",
      "id": "Kini implementasinya harus diperiksa dengan cermat.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
