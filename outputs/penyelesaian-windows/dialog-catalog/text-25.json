      "index": 0,
      "de": "Bima kann heute nicht ins Büro kommen.",
      "id": "Bima tidak bisa datang ke kantor hari ini.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Er schreibt seinem Chef eine kurze Nachricht.",
      "id": "Dia menulis pesan singkat kepada atasannya.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Er erklärt, dass sein Zug ausgefallen ist.",
      "id": "Dia menjelaskan bahwa keretanya dibatalkan.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Sein Chef antwortet sofort und wünscht ihm eine gute Fahrt.",
      "id": "Atasannya segera membalas dan mendoakan perjalanan yang lancar.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Bima kommt am nächsten Morgen pünktlich.",
      "id": "Bima datang tepat waktu keesokan paginya.",
