    {
      "index": 0,
      "de": "Ich habe seit drei Tagen Kopfschmerzen.",
      "id": "Saya sudah tiga hari sakit kepala.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Heute habe ich einen Termin beim Arzt.",
      "id": "Hari ini saya ada janji dengan dokter.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Praxis ist klein, aber der Arzt ist sehr freundlich.",
      "id": "Praktiknya kecil, tetapi dokternya sangat ramah.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Ich soll viel trinken und mich ausruhen.",
      "id": "Saya harus banyak minum dan beristirahat.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Das Rezept bringe ich in die Apotheke.",
      "id": "Resepnya saya bawa ke apotek.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Morgen fühle ich mich hoffentlich besser.",
      "id": "Semoga besok saya merasa lebih baik.",
