  "sourceMap": [
    {
      "index": 0,
      "de": "Nina hört gern Musik, wenn sie mit dem Bus fährt.",
      "id": "Nina senang mendengarkan musik saat naik bus.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Seit einem Jahr spielt sie auch Gitarre.",
      "id": "Dia juga sudah bermain gitar selama setahun.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Am Dienstag übt sie mit ihrer Freundin.",
      "id": "Pada hari Selasa dia berlatih bersama teman perempuannya.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Manchmal gehen beide danach zum Tanzkurs.",
      "id": "Kadang-kadang mereka berdua pergi ke kelas menari setelah itu.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Bewegung tut ihnen gut und macht Spaß.",
      "id": "Bergerak membuat mereka merasa lebih sehat dan senang.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    }
  ],
