    {
      "index": 0,
      "de": "Am Sonntag besuche ich meine Großmutter.",
      "id": "Hari Minggu saya mengunjungi nenek saya.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Sie wohnt in einem kleinen Haus.",
      "id": "Dia tinggal di sebuah rumah kecil.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Mein Onkel und meine Tante kommen auch.",
      "id": "Paman dan bibi saya juga datang.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Meine Cousine bringt einen Kuchen.",
      "id": "Sepupu perempuan saya membawa kue.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Wir essen zusammen und erzählen viel.",
      "id": "Kami makan bersama dan banyak bercerita.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Ich liebe meine Familie.",
