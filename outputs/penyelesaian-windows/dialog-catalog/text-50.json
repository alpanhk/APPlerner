  "sourceMap": [
    {
      "index": 0,
      "de": "Die Regierung hat eine neue Reform vorgeschlagen.",
      "id": "Pemerintah mengusulkan reformasi baru.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Der Minister sagt, die Reform sei notwendig für die Zukunft.",
      "id": "Menteri mengatakan reformasi itu perlu untuk masa depan.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Opposition kritisiert, die Kosten seien zu hoch.",
      "id": "Oposisi mengkritik bahwa biayanya terlalu tinggi.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Zwar ist eine Reform nötig, aber der Zeitpunkt ist umstritten.",
      "id": "Memang reformasi perlu, tetapi waktunya kontroversial.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Viele Bürger wünschen sich mehr Beteiligung.",
      "id": "Banyak warga menginginkan lebih banyak partisipasi.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Bei der Wahl im Herbst wird sich zeigen, wer Recht hat.",
      "id": "Pada pemilu musim gugur akan terlihat siapa yang benar.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
