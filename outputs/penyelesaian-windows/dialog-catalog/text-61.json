    {
      "index": 0,
      "de": "Ich habe seit zwei Tagen Zahnschmerzen.",
      "id": "Saya sudah dua hari sakit gigi.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Heute habe ich einen Termin beim Zahnarzt.",
      "id": "Hari ini saya ada janji dengan dokter gigi.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Ärztin untersucht zuerst den Zahn.",
      "id": "Dokter memeriksa giginya lebih dulu.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Ich bekomme eine Spritze, damit es nicht wehtut.",
      "id": "Saya mendapat suntikan agar tidak sakit.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Die Behandlung dauert zwanzig Minuten.",
      "id": "Pengobatannya dua puluh menit.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Morgen soll ich nicht kauen.",
      "id": "Besok saya tidak boleh mengunyah.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
