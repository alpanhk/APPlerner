    {
      "index": 0,
      "de": "Falsche Nachrichten verbreiten sich in Sekunden.",
      "id": "Berita palsu menyebar dalam hitungan detik.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Oft werden Bilder manipuliert, um Emotionen zu erzeugen.",
      "id": "Sering gambar dimanipulasi untuk memicu emosi.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Berichterstattung war in diesem Fall einseitig.",
      "id": "Pemberitaan dalam kasus ini sepihak.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Experten behaupten, die Quelle sei nicht glaubwürdig.",
      "id": "Pakar menyatakan sumbernya tidak kredibel.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Deshalb sollte man jede Meldung hinterfragen.",
      "id": "Karena itu setiap berita sebaiknya dipertanyakan.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Guter Journalismus recherchiert, bevor er veröffentlicht.",
      "id": "Jurnalisme yang baik menelusuri sebelum menerbitkan.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
