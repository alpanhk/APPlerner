      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Während der Fahrt liest Arif einen Reiseführer.",
      "id": "Selama perjalanan Arif membaca buku panduan wisata.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am Bahnhof holt ihn seine Cousine ab.",
