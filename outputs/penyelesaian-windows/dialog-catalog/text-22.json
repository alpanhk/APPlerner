      "de": "Am Freitag fährt Arif mit dem Zug nach Hamburg.",
      "id": "Pada hari Jumat Arif pergi ke Hamburg naik kereta.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Er hat die Fahrkarte schon im Internet gekauft.",
      "id": "Dia sudah membeli tiket kereta di internet.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Der Zug hat zehn Minuten Verspätung.",
