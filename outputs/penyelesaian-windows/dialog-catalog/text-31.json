  "sourceMap": [
    {
      "index": 0,
      "de": "Am Samstag war ich im Supermarkt.",
      "id": "Hari Sabtu saya di supermarket.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Es gab ein Angebot für Kaffee.",
      "id": "Ada penawaran untuk kopi.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Der Kaffee war günstiger als letzte Woche.",
      "id": "Kopinya lebih murah dari pekan lalu.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "An der Kasse habe ich mit Karte bezahlt.",
      "id": "Di kasir saya membayar dengan kartu.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Die Quittung habe ich in meine Tasche gelegt.",
      "id": "Struknya saya simpan di tas.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Zu Hause habe ich die Lieferung für Montag bestellt.",
      "id": "Di rumah saya memesan pengiriman untuk hari Senin.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
