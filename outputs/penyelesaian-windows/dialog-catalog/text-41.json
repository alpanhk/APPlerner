  "sourceMap": [
    {
      "index": 0,
      "de": "Seit drei Jahren arbeitet Rina in diesem Unternehmen.",
      "id": "Sudah tiga tahun Rina bekerja di perusahaan ini.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Letztes Jahr wurde sie zur Teamleiterin gemacht.",
      "id": "Tahun lalu dia dijadikan pemimpin tim.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Obwohl die Arbeit stressig ist, macht sie ihr Spaß.",
      "id": "Meskipun pekerjaannya penuh stres, dia menyukainya.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Das neue Projekt muss bis Ende des Monats beendet werden.",
      "id": "Proyek baru harus selesai akhir bulan.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Trotzdem nimmt sie sich Zeit für eine Fortbildung.",
      "id": "Meskipun begitu dia menyempatkan diri untuk pelatihan.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Sie hofft, dass ihre Karriere so weitergeht.",
      "id": "Dia berharap kariernya terus berjalan seperti ini.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
