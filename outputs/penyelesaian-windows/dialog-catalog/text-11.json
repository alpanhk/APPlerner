      "id": "Ibu saya memasak nasi dengan sayur.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Mein Vater trinkt Wasser, ich trinke Saft.",
      "id": "Ayah saya minum air, saya minum jus.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Zum Frühstück esse ich Brot mit Käse.",
