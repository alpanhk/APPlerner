  "sourceMap": [
    {
      "index": 0,
      "de": "Am Samstag bin ich mit Freunden gewandert.",
      "id": "Hari Sabtu saya mendaki bersama teman-teman.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Das Wetter war schön und die Landschaft war ruhig.",
      "id": "Cuacanya bagus dan pemandangannya tenang.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Am Abend sind wir ins Kino gegangen.",
      "id": "Malamnya kami pergi ke bioskop.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Der Film war spannend, aber ein bisschen lang.",
      "id": "Filmnya seru, tapi agak panjang.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Am Sonntag habe ich nur gelesen und Musik gehört.",
      "id": "Hari Minggu saya hanya membaca dan mendengar musik.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Nächste Woche werde ich zum ersten Mal ins Museum gehen.",
      "id": "Pekan depan saya akan pertama kali pergi ke museum.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
