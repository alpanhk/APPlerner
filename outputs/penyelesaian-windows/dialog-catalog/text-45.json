  "sourceMap": [
    {
      "index": 0,
      "de": "In meinem Viertel leben Menschen aus vielen Ländern.",
      "id": "Di lingkungan saya tinggal orang dari banyak negara.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Integration wird oft durch Sprachkurse unterstützt.",
      "id": "Integrasi sering didukung lewat kursus bahasa.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Manche haben Vorurteile, weil sie wenig wissen.",
      "id": "Sebagian punya prasangka karena kurang tahu.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Ein Konflikt wurde gelöst, indem man miteinander gesprochen hat.",
      "id": "Sebuah konflik terselesaikan dengan saling bicara.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Es wäre schön, wenn alle respektvoll wären.",
      "id": "Akan bagus jika semua saling menghormati.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Viele engagieren sich für ein gutes Zusammenleben.",
      "id": "Banyak orang berdedikasi untuk hidup bersama yang baik.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
