  "sourceMap": [
    {
      "index": 0,
      "de": "Seit Wochen sucht Fajar eine neue Stelle.",
      "id": "Sejak berpekan-pekan Fajar mencari posisi baru.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Er hat mehrere Bewerbungen geschrieben.",
      "id": "Dia menulis beberapa lamaran.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Firma hat ihn zu einem Gespräch eingeladen.",
      "id": "Perusahaannya mengundangnya wawancara.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Im Gespräch betonte er, dass er zuverlässig und flexibel sei.",
      "id": "Dalam wawancara dia menekankan bahwa dia dapat diandalkan dan fleksibel.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Zwei Tage später bekam er die Zusage.",
      "id": "Dua hari kemudian dia mendapat persetujuan.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Er freut sich auf die neue Aufgabe.",
      "id": "Dia menantikan tugas baru itu.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
