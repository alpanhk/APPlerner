  "sourceMap": [
    {
      "index": 0,
      "de": "Bevor wir nach Wien gefahren sind, hatten wir alles gebucht.",
      "id": "Sebelum pergi ke Wina, kami sudah memesan semuanya.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Die Unterkunft, die wir gefunden hatten, war zentral.",
      "id": "Akomodasi yang kami temukan berada di pusat.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Am ersten Tag haben wir eine Führung gemacht.",
      "id": "Hari pertama kami ikut tur berpemandu.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Der Reiseführer hat uns viele Geschichten erzählt.",
      "id": "Pemandunya bercerita banyak kisah.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Nachdem wir das Museum besichtigt hatten, waren wir müde.",
      "id": "Setelah mengunjungi museum, kami lelah.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Am Abend haben wir mit Einheimischen gesprochen.",
      "id": "Malamnya kami berbicara dengan penduduk lokal.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
