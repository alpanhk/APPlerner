  "sourceMap": [
    {
      "index": 0,
      "de": "Viele Menschen möchten klimafreundlicher leben.",
      "id": "Banyak orang ingin hidup lebih ramah iklim.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Sie fahren häufiger Fahrrad oder benutzen den Bus.",
      "id": "Mereka lebih sering bersepeda atau memakai bus.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Außerdem trennen sie den Müll zu Hause.",
      "id": "Selain itu mereka memilah sampah di rumah.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Beim Einkaufen achten sie auf Verpackungen.",
      "id": "Saat berbelanja mereka memperhatikan kemasan.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Es ist jedoch nicht immer einfach, konsequent zu bleiben.",
      "id": "Namun tidak selalu mudah untuk konsisten.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Kleine Entscheidungen können dennoch viel bewirken.",
      "id": "Keputusan kecil tetap bisa berpengaruh banyak.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
