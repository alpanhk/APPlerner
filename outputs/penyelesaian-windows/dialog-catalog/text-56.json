      "index": 0,
      "de": "Die Diagnose kam vor drei Jahren.",
      "id": "Diagnosisnya datang tiga tahun lalu.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Seitdem wird sie regelmäßig behandelt.",
      "id": "Sejak itu dia diobati secara teratur.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Die Behandlung wirkt, hat aber Nebenwirkungen.",
      "id": "Pengobatannya efektif, tetapi ada efek samping.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "Die Ursache der Krankheit ist bis heute unklar.",
      "id": "Penyebab penyakitnya sampai kini tidak jelas.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Prävention wäre früher möglich gewesen.",
      "id": "Pencegahan sebenarnya bisa dilakukan lebih awal.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Gute Aufklärung hilft anderen Betroffenen.",
