  "sourceMap": [
    {
      "index": 0,
      "de": "Seit ich einen Lernplan habe, macht das Lernen mehr Spaß.",
      "id": "Sejak punya rencana belajar, belajar jadi lebih menyenangkan.",
      "mappedTo": [
        "t01"
      ],
      "kind": "dialogue"
    },
    {
      "index": 1,
      "de": "Ich versuche, jeden Tag zwanzig Minuten zu üben.",
      "id": "Saya berusaha berlatih dua puluh menit setiap hari.",
      "mappedTo": [
        "t02"
      ],
      "kind": "dialogue"
    },
    {
      "index": 2,
      "de": "Neue Wörter wiederhole ich abends vor dem Schlafen.",
      "id": "Kata-kata baru saya ulang malam sebelum tidur.",
      "mappedTo": [
        "t03"
      ],
      "kind": "dialogue"
    },
    {
      "index": 3,
      "de": "In der Prüfung wird viel geschrieben und gehört.",
      "id": "Dalam ujian banyak menulis dan mendengar.",
      "mappedTo": [
        "t04"
      ],
      "kind": "dialogue"
    },
    {
      "index": 4,
      "de": "Deshalb übe ich auch Hörverstehen.",
      "id": "Karena itu saya juga berlatih pemahaman mendengar.",
      "mappedTo": [
        "t05"
      ],
      "kind": "dialogue"
    },
    {
      "index": 5,
      "de": "Der Fortschritt ist langsam, aber ich bin motiviert.",
      "id": "Kemajuannya lambat, tetapi saya termotivasi.",
      "mappedTo": [
        "t06"
      ],
      "kind": "dialogue"
    }
  ],
